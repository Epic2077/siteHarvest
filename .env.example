# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Personal access token for running migrations via the Supabase Management API.
# Create one at: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_personal_access_token

# Crawl defaults
CRAWLER_USER_AGENT=SiteHarvestBot/0.1 (+https://github.com/YOUR_USERNAME/siteharvest)
CRAWLER_DELAY_MS=250
CRAWLER_CONCURRENCY=3
CRAWLER_FLUSH_BATCH=20
CRAWLER_TIMEOUT_MS=30000
CRAWLER_RETRIES=2
