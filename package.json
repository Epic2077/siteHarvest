{
  "name": "siteharvest",
  "version": "0.1.0",
  "description": "A TypeScript CLI for discovering website technology, crawling structured content, normalizing products/categories, and persisting them to Supabase/Postgres.",
  "type": "module",
  "bin": {
    "siteharvest": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "dotenv": "^17.2.2",
    "p-limit": "^7.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
